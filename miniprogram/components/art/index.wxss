:host{display:block;width:100%;height:100%}.frame{position:relative;width:100%;height:100%;overflow:hidden;background:#eeede6;border-radius:inherit}.photo{width:100%;height:100%;display:block}.atlas{position:absolute;width:200%;height:200%;max-width:none;display:block}.sofa{left:0;top:0}.kindle{left:-100%;top:0}.sweater{left:0;top:-100%}.camera{left:-100%;top:-100%}.placeholder{height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#929987;font-size:20rpx}.glyph{font-family:serif;font-size:76rpx;margin-bottom:12rpx}
.frame.natural{height:auto}.natural .photo{height:auto}
