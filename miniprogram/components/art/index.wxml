<view class="frame {{src && fit==='natural'?'natural':''}}"><image wx:if="{{src && !broken}}" class="photo" src="{{src}}" mode="{{fit==='natural'?'widthFix':fit==='contain'?'aspectFit':'aspectFill'}}" binderror="failed"/><image wx:elif="{{kind}}" class="atlas {{kind}}" src="/assets/collection.jpg" mode="scaleToFill"/><view wx:else class="placeholder"><text class="glyph">物</text><text>等待一张生活里的照片</text></view></view>
