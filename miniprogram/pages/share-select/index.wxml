<view class="page share-page">
 <view class="share-title serif">选择分享物品</view>
 <view class="share-search"><text>⌕</text><input value="{{query}}" placeholder="搜索物品名称" bindinput="search" maxlength="-1"/></view>
 <button class="share-chooser" bindtap="openPicker"><text>＋ 从物品中选择</text><text>›</text></button>
 <block wx:if="{{query}}"><view class="share-heading"><text class="serif">搜索结果</text><text class="share-muted">{{results.length}} 件</text></view><button wx:for="{{results}}" wx:key="id" class="share-item-row" bindtap="choose" data-id="{{item.id}}"><view class="share-thumb"><art src="{{item.photo}}" kind="{{item.art}}" fit="contain"/></view><view class="share-item-copy"><view>{{item.name}}</view><view class="share-muted">{{item.category}} · {{item.sub}}</view></view><text>›</text></button><view wx:if="{{!results.length}}" class="share-empty">没有找到这件物品，试试别的名称。</view></block>
 <block wx:else><view class="share-heading"><text class="serif">我的好物展台</text><text class="share-muted">{{showcase.length}} 件</text></view><view class="share-showcase"><button wx:for="{{showcase}}" wx:key="id" class="share-stage" bindtap="choose" data-id="{{item.id}}"><view class="share-frame"><view class="share-stage-photo"><art src="{{item.photo}}" kind="{{item.art}}" fit="contain"/></view><view class="serif">{{item.name}}</view></view><view class="share-tray"/><view class="share-muted">{{item.category}} · {{item.sub}}</view></button></view><view wx:if="{{!showcase.length}}" class="share-empty">{{ownedCount?'展台还没有物品，可以搜索或从分类中选择。':'还没有正在拥有的物品。'}}<button wx:if="{{!ownedCount}}" class="link" bindtap="add">添加第一件好物</button></view></block>
</view>
<view wx:if="{{picker}}" class="share-page share-overlay"><view class="share-mask" bindtap="closePicker"/><view class="share-sheet" role="dialog" aria-label="选择物品"><view class="share-sheet-head"><text class="serif">选择物品</text><button bindtap="closePicker" aria-label="关闭选择物品">×</button></view><scroll-view scroll-x="true" class="share-categories"><view class="share-track"><button wx:for="{{categories}}" wx:key="id" class="share-category {{categoryId===item.id?'active':''}}" data-id="{{item.id}}" bindtap="parent">{{item.name}}</button></view></scroll-view><scroll-view wx:if="{{categoryId}}" scroll-x="true" class="share-subcategories"><view class="share-track"><button wx:for="{{children}}" wx:key="id" class="share-subcategory {{subId===item.id?'active':''}}" data-id="{{item.id}}" bindtap="child">{{item.name}}</button></view></scroll-view><scroll-view scroll-y="true" class="share-sheet-list"><button wx:for="{{choices}}" wx:key="id" class="share-item-row" bindtap="choose" data-id="{{item.id}}"><view class="share-thumb"><art src="{{item.photo}}" kind="{{item.art}}" fit="contain"/></view><view class="share-item-copy"><view>{{item.name}}</view><view class="share-muted">{{item.category}} · {{item.sub}}</view></view><text>›</text></button><view wx:if="{{!choices.length}}" class="share-empty">没有符合分类的正在拥有物品。</view></scroll-view></view></view>
