@import "../../utils/share.wxss";
.share-detail-top{display:flex;align-items:center;justify-content:space-between;padding:8rpx 0 22rpx}.share-back,.share-detail-share{font-size:54rpx;line-height:1;color:#30352d;width:60rpx;text-align:center}.share-detail-share{font-size:38rpx}.share-author{display:flex;align-items:center;gap:14rpx}.share-author-name{font-size:28rpx;color:#30352d}.share-detail-gallery{width:calc(100% + 48rpx);margin-left:-24rpx;white-space:nowrap;height:540rpx}.share-detail-slide{display:inline-block;width:calc(100vw - 48rpx);height:540rpx;margin-right:14rpx;border-radius:14rpx;overflow:hidden;background:#eeede6;vertical-align:top}.share-detail-slide image,.share-detail-slide art{width:100%;height:100%;display:block}.share-detail-dots{display:flex;justify-content:center;gap:12rpx;margin:20rpx 0 26rpx}.share-detail-dot{width:14rpx;height:14rpx;border-radius:50%;background:#d5d7d0}.share-detail-dot.active{background:#69765e}.share-detail-meta{display:flex;justify-content:space-between;align-items:center;border-bottom:1rpx solid #e5e5dc;padding:4rpx 0 22rpx;color:#69765e;font-size:23rpx}.share-detail-meta text:last-child{color:#69765e}.share-detail-actions{display:flex;justify-content:space-around;border-top:1rpx solid #ebe8df;margin-top:28rpx;padding:22rpx 0;color:#69765e;font-size:24rpx}.share-detail-actions text{min-width:180rpx;text-align:center}.share-page .share-footer{position:fixed;left:0;right:0;bottom:0;background:#f8f7f1;padding:14rpx 24rpx calc(14rpx + env(safe-area-inset-bottom));z-index:5}.share-page.share-with-footer{padding-bottom:130rpx}
