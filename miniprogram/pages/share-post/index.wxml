<view class="page share-page share-with-footer"><view wx:if="{{error}}" class="share-empty">{{error}}<button class="link" bindtap="back">返回</button></view><block wx:elif="{{post}}"><view wx:if="{{published}}" class="share-success">✓ 已保存到本机社区</view><view class="share-detail-top"><view class="share-back" bindtap="back">‹</view><view class="share-author"><view class="share-avatar">我</view><view class="share-author-name">{{post.author}}</view></view><view class="share-detail-share">↗</view></view><scroll-view class="share-detail-gallery" scroll-x="true" enhanced="true" show-scrollbar="false"><view wx:for="{{gallery}}" wx:key="*this" class="share-detail-slide"><art wx:if="{{!item}}" src="" kind="{{post.item.art}}" fit="cover"/><image wx:else src="{{item}}" mode="aspectFill" data-src="{{item}}" bindtap="photos"/></view></scroll-view><view wx:if="{{galleryCount > 1}}" class="share-detail-dots"><view wx:for="{{gallery}}" wx:key="*this" class="share-detail-dot {{index===0?'active':''}}"></view></view><view class="share-detail-meta"><text>{{post.item.category}}{{post.item.sub ? ' · ' + post.item.sub : ''}}</text><text>建档 {{post.item.createdDate || '未记录'}}</text></view><view class="share-title serif">{{post.title}}</view><view class="share-body">{{post.text}}</view><view class="share-detail-actions"><text>♡ 收藏</text><text>○ 回复</text></view><view class="share-footer"><block wx:if="{{preview}}"><button class="secondary" bindtap="back" disabled="{{busy}}">返回编辑</button><button class="primary" bindtap="publish" disabled="{{busy}}">{{busy?'正在保存…':'确认发布'}}</button></block><button wx:else class="primary" bindtap="community">去社区看看</button></view></block></view>
