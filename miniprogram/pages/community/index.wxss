@import "../../utils/share.wxss";
.community-page{padding-top:34rpx}.community-intro{font-size:25rpx;color:#85897d;margin-top:6rpx}.community-filters{display:flex;gap:14rpx;margin:34rpx 0 22rpx;overflow-x:auto;white-space:nowrap}.community-filter{padding:10rpx 22rpx;border:1rpx solid #dfded5;border-radius:30rpx;color:#777a70;font-size:23rpx}.community-filter.active{border-color:#69765e;background:#69765e;color:#fff}.community-feed-note{font-size:21rpx;color:#98998f;margin-bottom:10rpx}.community-card{background:#fffefa;border:1rpx solid #ebe8df;border-radius:14rpx;overflow:hidden;margin-bottom:24rpx;box-shadow:0 5rpx 18rpx #48463408}.community-card-photo{height:330rpx;background:#eeede6;overflow:hidden;border-radius:12rpx;margin-top:18rpx}.community-card-content{padding:20rpx 22rpx 18rpx}.community-user{display:flex;align-items:center;gap:12rpx}.community-avatar{width:48rpx;height:48rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#e1e6d9;color:#69765e;font-size:22rpx}.community-author{font-size:22rpx;color:#34382f}.community-item-meta{margin-top:14rpx;font-size:21rpx;color:#69765e}.community-item-meta text{padding:0 7rpx;color:#b6b6aa}.community-post-title{font-family:"Songti SC","STSong","Noto Serif CJK SC","SimSun",serif;font-size:32rpx;font-weight:600;margin-top:18rpx;color:#292c26}.community-post-text{font-size:24rpx;line-height:1.8;color:#686d63;margin-top:8rpx;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3;overflow:hidden}.community-actions{display:flex;justify-content:space-between;border-top:1rpx solid #ebe8df;margin-top:18rpx;padding:16rpx 8rpx 0;color:#69765e;font-size:22rpx}.community-status{display:none}
