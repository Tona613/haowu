<view class="page form-page"><view class="title">{{kind==='stories'?'留下这一刻':'记录一次维修'}}</view><view class="mini-item"><view class="mini-art"><art src="{{item.photo}}" kind="{{item.art}}"/></view><view><view class="inline-name">{{item.name}}</view><view class="small muted">{{item.dayText}}</view></view></view><view class="field"><text class="label">{{kind==='stories'?'记录日期':'维修日期'}} *</text><picker mode="date" start="{{item.start}}" end="{{max}}" value="{{form.date}}" bindchange="input" data-key="date"><view class="control row"><text>{{form.date}}</text><text>⌄</text></view></picker></view><view wx:if="{{kind==='stories'}}" class="field"><text class="label">这一刻</text><view class="control"><textarea maxlength="5000" value="{{form.text}}" placeholder="今天，你和它发生了什么？" bindinput="input" data-key="text"/></view><view class="hint">文字和照片，至少留下一项就好。</view></view><view wx:else><view class="field"><text class="label">出了什么问题 *</text><view class="control"><textarea maxlength="1000" value="{{form.problem}}" placeholder="例如：右侧扶手有些松动" bindinput="input" data-key="problem"/></view></view><view class="field"><text class="label">怎么处理的</text><view class="control"><textarea maxlength="2000" value="{{form.treatment}}" placeholder="例如：联系师傅上门重新固定" bindinput="input" data-key="treatment"/></view></view><view class="field"><text class="label">维修费用</text><view class="control"><input type="digit" value="{{form.cost}}" placeholder="¥ 选填，免费可填 0" bindinput="input" data-key="cost"/></view></view></view><view class="field"><text class="label">照片 · 最多6张</text><view class="photo-list"><view wx:for="{{form.photos}}" wx:key="*this" class="photo-cell"><image src="{{item}}" mode="aspectFill"/><view class="remove-photo" bindtap="removePhoto" data-index="{{index}}">×</view></view><view wx:if="{{form.photos.length<6}}" class="photo-add" bindtap="photos">＋</view></view></view><view wx:if="{{kind==='repairs'}}" class="field"><text class="label">补充说明</text><view class="control"><textarea maxlength="2000" value="{{form.note}}" placeholder="修好后的状态，或其他想留存的信息" bindinput="input" data-key="note"/></view></view><view class="hint section">这些记录仅保存在本机，不会公开发布。</view><view class="actions"><button class="secondary" bindtap="cancel">取消</button><button class="primary" disabled="{{busy}}" bindtap="save">保存</button></view><button wx:if="{{editing}}" class="danger section" bindtap="remove">删除这条记录</button></view>
