/* Scoped item form only. */
.item-form-page .item-form-intro{font-size:34rpx;font-weight:500;color:#34382f;line-height:1.5;margin:6rpx 0 24rpx}
.item-form-page .item-photo-wrap{position:relative;width:200rpx;margin:0 auto 28rpx}
.item-form-page .upload{width:200rpx;height:200rpx;margin:0;border-radius:16rpx;cursor:pointer}
.item-form-page .item-photo-delete{position:absolute;right:8rpx;top:8rpx;width:48rpx;height:48rpx;padding:0;line-height:44rpx;font-family:Arial,sans-serif;font-size:36rpx;background:#292c26aa;color:#fff;border-radius:50%;z-index:2}
.item-form-page .item-showcase-row{display:flex;align-items:center;justify-content:space-between;padding:14rpx 0;border-bottom:1rpx solid #e6e5dc;margin-bottom:8rpx}
.item-form-page .item-showcase-row .label{margin:0}
.item-form-page .item-showcase-toggle{width:84rpx;height:48rpx;border-radius:48rpx;padding:5rpx;background:#dadcd2;line-height:1;flex-shrink:0}
.item-form-page .item-showcase-toggle.is-on{background:#69765e}
.item-form-page .item-switch-thumb{width:38rpx;height:38rpx;border-radius:50%;background:#fffef9;box-shadow:0 2rpx 5rpx #39422b20;transition:transform .15s}
.item-form-page .is-on .item-switch-thumb{transform:translateX(36rpx)}
.item-form-page .field{margin-top:24rpx}
.item-form-page .label{font-size:31rpx;font-weight:500;color:#34382f;line-height:1.5;margin-bottom:10rpx}
.item-form-page .control{min-height:88rpx;padding:0 22rpx;border:1rpx solid #e0e2d7;background:#f1f1eb;border-radius:12rpx;font-size:29rpx;color:#292c26}
.item-form-page .control.row{height:88rpx}
.item-form-page input{font-size:29rpx;height:86rpx;line-height:normal;color:#292c26}
.item-form-page textarea{font-size:29rpx;min-height:144rpx;height:144rpx;line-height:1.7;padding:16rpx 0;color:#292c26}
.item-form-page .item-placeholder,.item-form-page input::placeholder,.item-form-page textarea::placeholder{font-size:27rpx;font-weight:400;color:#8c9085;opacity:1}
.item-form-page input[type="date"]{height:88rpx;width:100%;padding:0 22rpx;border:1rpx solid #e0e2d7;background:#f1f1eb;border-radius:12rpx;font-size:29rpx}
.item-form-page .required{color:#69765e}
