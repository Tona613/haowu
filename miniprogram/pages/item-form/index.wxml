<view class="page form-page item-form-page"><view class="item-form-intro serif">先记下拥有，故事慢慢生长</view><view class="item-photo-wrap"><view class="upload" bindtap="photo"><art wx:if="{{form.photo || form.art}}" src="{{form.photo}}" kind="{{form.art}}"/><view wx:else>＋<view class="small">添加照片</view></view></view><button wx:if="{{form.photo || form.art}}" class="item-photo-delete" catchtap="clearPhoto" aria-label="移除照片">×</button></view><view wx:if="{{!editing}}" class="item-showcase-row"><view><text class="label">放上我的展台</text></view><button class="item-showcase-toggle {{form.showcase?'is-on':''}}" bindtap="toggleShowcase" disabled="{{!form.photo && !form.art}}" role="switch" aria-label="放上我的展台" aria-checked="{{form.showcase}}"><view class="item-switch-thumb"/></button></view><view class="field"><text class="label">物品名称 <text class="required">*</text></text><view class="control"><input placeholder-class="item-placeholder" maxlength="40" value="{{form.name}}" placeholder="给它一个熟悉的名字" data-key="name" bindinput="input"/></view></view><view class="field"><text class="label">分类 <text class="required">*</text></text><view class="control row" bindtap="category"><text class="{{form.sub?'':'item-placeholder'}}">{{form.sub?form.category+' · '+form.sub:'请选择分类'}}</text><text>›</text></view></view><view class="field"><text class="label">拥有开始日期 <text class="required">*</text></text><picker mode="date" value="{{form.start}}" end="{{today}}" data-key="start" bindchange="input"><view class="control row"><text>{{form.start}}</text><text>⌄</text></view></picker></view><view class="field"><text class="label">购入价格</text><view class="control"><input placeholder-class="item-placeholder" type="digit" value="{{form.price}}" placeholder="¥ 选填，未知可留空" data-key="price" bindinput="input"/></view></view><view class="field"><text class="label">购入渠道</text><view class="control row" bindtap="channel"><text class="{{form.channel?'':'item-placeholder'}}">{{form.channel || '在哪里遇见它？'}}</text><text>›</text></view></view><view class="field"><text class="label">来到身边的理由</text><view class="control"><textarea placeholder-class="item-placeholder" maxlength="2000" value="{{form.reason}}" placeholder="当时，为什么想拥有它？" data-key="reason" bindinput="input"/></view></view><view class="field"><text class="label">来自谁</text><view class="control row" bindtap="source"><text>{{form.source}}</text><text>›</text></view></view><button wx:if="{{editing}}" class="link" bindtap="more">{{more?'收起详细资料':'补充品牌、型号等详细资料'}} ⌄</button><view wx:if="{{editing && more}}"><view class="field"><text class="label">品牌</text><view class="control"><input placeholder-class="item-placeholder" value="{{form.brand}}" data-key="brand" bindinput="input" maxlength="80"/></view></view><view class="field"><text class="label">型号</text><view class="control"><input placeholder-class="item-placeholder" value="{{form.model}}" data-key="model" bindinput="input" maxlength="100"/></view></view><view class="field"><text class="label">尺寸</text><view class="control"><input placeholder-class="item-placeholder" value="{{form.size}}" data-key="size" bindinput="input" maxlength="100"/></view></view><view class="field"><text class="label">购买链接</text><view class="control"><input placeholder-class="item-placeholder" value="{{form.link}}" data-key="link" bindinput="input" maxlength="2000"/></view></view><view class="field"><text class="label">备注</text><view class="control"><textarea placeholder-class="item-placeholder" value="{{form.note}}" data-key="note" bindinput="input" maxlength="2000"/></view></view></view><view class="actions"><button class="secondary" bindtap="cancel">取消</button><button class="primary" disabled="{{busy}}" bindtap="save">保存物品</button></view></view>
