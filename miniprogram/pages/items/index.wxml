<view class="page"><view class="title">我的物品</view><view class="section-note">那些进入生活，也留下痕迹的东西。</view><view class="search"><input placeholder="搜索名称、品牌、型号" value="{{query}}" bindinput="search"/></view><view class="tabs"><view class="tab {{status==='owned'?'active':''}}" bindtap="status" data-value="owned">正在拥有</view><view class="tab {{status==='past'?'active':''}}" bindtap="status" data-value="past">曾经拥有</view><view class="tab {{status==='all'?'active':''}}" bindtap="status" data-value="all">全部</view></view><view class="catalog"><scroll-view wx:if="{{!query}}" scroll-y class="sidebar"><view class="side {{!categoryId?'active':''}}" bindtap="category" data-id="">全部({{count}})</view><view wx:for="{{categories}}" wx:key="id" class="side {{categoryId===item.id?'active':''}}" bindtap="category" data-id="{{item.id}}">{{item.name}}({{item.count}})</view></scroll-view><view class="catalog-main"><scroll-view wx:if="{{categoryId && !query}}" scroll-x class="scroll-chips"><view class="chip {{!subId?'selected':''}}" bindtap="sub" data-id="">全部</view><view wx:for="{{children}}" wx:key="id" class="chip {{subId===item.id?'selected':''}}" bindtap="sub" data-id="{{item.id}}">{{item.name}} {{item.count}}</view></scroll-view><view wx:if="{{limitText && !query}}" class="note" bindtap="limit">{{limitText}}</view><view class="small muted">{{items.length}} 件{{query?'匹配物品':''}}</view><view class="grid"><view wx:for="{{items}}" wx:key="id" bindtap="open" data-id="{{item.id}}"><view class="item-image"><art src="{{item.photo}}" kind="{{item.art}}"/></view><view class="item-name">{{item.name}}</view><view class="item-days">{{item.dayText}}</view></view></view><view wx:if="{{!items.length}}" class="empty"><view class="empty-symbol">·</view><view>这里还没有物品</view><view class="hint">试试其他分类，或从首页添加。</view></view></view></view></view>
