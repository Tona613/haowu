<view class="page share-page share-with-footer">
 <view wx:if="{{error}}" class="share-empty">{{error}}<button class="link" bindtap="back">返回选择</button></view>
 <block wx:elif="{{item}}"><view class="share-title serif">分享相处的感受</view><view class="share-item-card"><view class="share-item-row"><view class="share-thumb"><art src="{{item.photo}}" kind="{{item.art}}" fit="contain"/></view><view class="share-item-copy"><view>{{item.name}}</view><view class="share-muted">{{item.category}} · {{item.sub}}</view></view></view><view class="share-dates"><view><view class="share-muted">建档日期</view><view>{{item.createdDate}}</view></view><view><view class="share-muted">拥有时长</view><view>{{item.ownedDays === null ? "未记录" : item.ownedDays + " 天"}}</view></view></view></view><view class="share-disclosure">以上物品信息将随帖子公开 · 时长根据你填写的拥有开始日期计算</view>
 <view class="share-field"><view class="share-label">分享标题 <text class="green">*</text></view><input class="share-input {{titleError?'share-invalid':''}}" value="{{form.title}}" placeholder="这件好物，最想分享的一点" maxlength="-1" data-key="title" bindinput="input"/><view class="share-error">{{titleError}}</view></view>
 <view class="share-field"><view class="share-label-row"><text class="share-label">使用体验 <text class="green">*</text></text><button wx:if="{{review}}" class="share-reference" bindtap="reference">参考我的评价 ›</button></view><textarea class="share-input share-textarea {{textError?'share-invalid':''}}" value="{{form.text}}" placeholder="喜欢的地方、不太适合的地方，都可以说说。" maxlength="-1" data-key="text" bindinput="input"/><view class="share-error">{{textError}}</view><view class="share-char-count">已输入 {{chars}} 字</view></view>
 <view class="share-field"><view class="share-label">补充照片</view><view class="share-photos"><view wx:for="{{form.photos}}" wx:key="*this" class="share-photo"><image src="{{item}}" mode="aspectFill" bindtap="photo" data-src="{{item}}"/><button class="share-remove" catchtap="removePhoto" data-index="{{index}}" aria-label="删除补充照片">×</button></view><button wx:if="{{form.photos.length<6}}" class="share-upload" bindtap="photos" disabled="{{busy}}"><view>＋</view><text>添加照片</text></button></view><view class="share-muted">{{form.photos.length}} / 6</view></view><view wx:if="{{saveError}}" class="share-error">{{saveError}}</view><view class="share-local-note">草稿和帖子保存在本机，尚未开放给其他用户。</view><view class="share-footer"><button class="secondary" bindtap="back" disabled="{{busy}}">返回选择</button><button class="primary" bindtap="preview" disabled="{{busy}}">下一步 · 预览</button></view></block>
</view>
<view wx:if="{{reviewOpen}}" class="share-page share-overlay"><view class="share-mask" bindtap="closeReview"/><view class="share-sheet" role="dialog" aria-label="参考我的评价"><view class="share-sheet-head"><text class="serif">我的评价</text><button bindtap="closeReview" aria-label="关闭我的评价">×</button></view><scroll-view scroll-y="true" class="share-review-content"><view class="share-muted">喜欢的地方</view><view>{{review.pros || '尚未填写'}}</view><view class="share-muted">不太满意的地方</view><view>{{review.cons || '尚未填写'}}</view><view class="share-muted">如果重新选择</view><view>{{review.again}}</view><view class="share-disclosure">仅供你参考，不会自动加入正文或公开。</view></scroll-view><button class="primary" bindtap="closeReview">回去写写感受</button></view></view>
