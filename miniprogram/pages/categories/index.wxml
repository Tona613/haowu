<view class="page"><view class="title">{{select?'选择分类':'分类与持有上限'}}</view><view class="hint">{{select?'给物品找一个合适的位置。':'点击二级分类设置上限，达到后仍可继续添加。'}}</view><view class="search"><input value="{{query}}" placeholder="搜索分类名称" bindinput="search"/></view><view wx:if="{{query}}"><view wx:for="{{results}}" wx:key="id" class="menu-row" bindtap="choose" data-parent="{{item.categoryId}}" data-id="{{item.id}}">{{item.category}} · {{item.name}}<text>›</text></view><view wx:if="{{!results.length}}" class="empty">没有找到分类，可清空搜索后新建。</view></view><view wx:else class="catalog"><scroll-view scroll-y class="sidebar"><view wx:for="{{categories}}" wx:key="id" class="side {{parent.id===item.id?'active':''}}" data-id="{{item.id}}" bindtap="parent">{{item.name}}</view><view class="side green" bindtap="addParent">＋ 新建分类</view></scroll-view><view class="catalog-main"><view class="section-title">{{parent.name}}</view><view class="chips section"><view wx:for="{{parent.children}}" wx:key="id" class="chip" data-id="{{item.id}}" bindtap="choose">{{item.name}}<view wx:if="{{item.limit!==null}}" class="tiny muted">上限 {{item.limit}}</view></view></view><view wx:if="{{!parent.children.length}}" class="hint">还没有二级分类</view><button class="link section" bindtap="addSub">＋ 新建二级分类</button></view></view></view>
