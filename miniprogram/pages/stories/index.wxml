<view class="page"><view class="title">与 {{item.name}} 的故事</view><view class="section-note">{{item.dayText}} · {{records.length}} 段记忆</view><view wx:if="{{!records.length}}" class="empty">还没有留下故事<view class="hint">留住一次普通又特别的日常。</view></view><view wx:for="{{records}}" wx:key="id" class="timeline"><view class="row"><view class="small muted">陪伴第 {{item.day}} 天 · {{item.date}}</view><button class="link" bindtap="edit" data-id="{{item.id}}">编辑</button></view><view class="story-text">{{item.text}}</view><view wx:if="{{item.art}}" class="story-photo"><art kind="{{item.art}}"/></view><image wx:for="{{item.photos}}" wx:for-item="photo" wx:key="*this" class="story-photo full" src="{{photo}}" mode="aspectFill" data-id="{{item.id}}" data-src="{{photo}}" bindtap="preview"/></view><button class="primary section" bindtap="add">＋ 记录故事</button></view>
