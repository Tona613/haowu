.select-item-page>.title{margin:4rpx 0 22rpx;font-size:36rpx}.select-search{height:88rpx;border:1rpx solid #e1e1d8;border-radius:12rpx;background:#f0f0e9;display:flex;align-items:center;padding:0 20rpx;gap:14rpx}.select-search-icon{font-size:38rpx;color:#7d8572;line-height:1}.select-search input{height:100%;flex:1;min-width:0;font-size:27rpx;color:#292c26}.select-search input::placeholder{font-size:27rpx;color:#8c9085;opacity:1}.select-chooser{height:68rpx;width:100%;display:flex;align-items:center;gap:8rpx;padding:0 4rpx;margin-top:6rpx;color:#69765e;background:transparent;text-align:left;font-size:27rpx;cursor:pointer}.select-chooser-plus{font-family:Arial,sans-serif;font-size:34rpx;font-weight:300}.select-chooser-chevron{margin-left:auto;font-size:36rpx;color:#929688}.select-section-head{margin:24rpx 0 4rpx}.select-section-head .section-title{font-size:34rpx}.select-story-row,.select-item-row{display:flex;align-items:center;gap:20rpx;padding:20rpx 0;border-bottom:1rpx solid #e6e5dc;cursor:pointer}.select-story-thumb{width:164rpx;height:164rpx;border-radius:12rpx;overflow:hidden;flex-shrink:0}.select-story-body,.select-item-copy{flex:1;min-width:0}.select-story-title{font-family:"Songti SC","STSong","SimSun",serif;font-size:29rpx;line-height:1.5;font-weight:600;color:#292c26;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.select-story-meta{font-size:23rpx;color:#909288;margin-top:6rpx}.select-story-excerpt{font-size:25rpx;line-height:1.55;color:#7d8177;margin-top:8rpx;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.select-chevron{font-size:34rpx;color:#a0a294}.select-thumb{width:100rpx;height:100rpx;border-radius:10rpx;overflow:hidden;flex-shrink:0}.select-item-name{font-size:29rpx;color:#292c26}.select-results{margin-top:18rpx}.select-results .section-title{font-size:32rpx}.select-picker-wrap{position:fixed;inset:0;z-index:100}.select-picker-mask{position:absolute;inset:0;background:#29291f55}.select-picker{position:absolute;left:0;right:0;bottom:0;background:#faf9f4;border-radius:24rpx 24rpx 0 0;padding:24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));box-shadow:0 -8rpx 30rpx #29291f18}.select-picker-header{display:flex;align-items:center;justify-content:space-between}.select-picker-title{font-family:"Songti SC","STSong","SimSun",serif;font-size:38rpx;font-weight:600}.select-picker-header button{font-size:27rpx;color:#69765e;padding:8rpx 0;cursor:pointer}.select-picker-note{font-size:24rpx;color:#92958a;margin:4rpx 0 10rpx}.select-picker-list{height:55vh;display:block;overflow-y:auto}
.select-story-item{font-size:24rpx;color:#6e795f}.select-story-date{font-size:21rpx;color:#93958b;margin-top:5rpx}.select-story-excerpt{margin-top:7rpx;font-size:27rpx;line-height:1.6;color:#292c26;white-space:pre-wrap;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.select-category-scroll,.select-subcategory-scroll{display:block;white-space:nowrap;overflow-x:auto;scrollbar-width:none}.select-category-track,.select-subcategory-track{display:flex;gap:10rpx;width:max-content;min-width:100%}.select-category-tab{font-size:25rpx;color:#73786e;padding:10rpx 14rpx 12rpx;border:1rpx solid transparent;border-bottom-color:#dcdcd3;border-radius:10rpx 10rpx 0 0;white-space:nowrap;cursor:pointer}.select-category-tab.active{background:#69765e;color:#fff;font-weight:600;border-color:#69765e}.select-subcategory-scroll{margin-top:14rpx;padding-top:10rpx}.select-subcategory-tab{font-size:24rpx;color:#6f7469;padding:8rpx 14rpx;border:1rpx solid #deded5;border-radius:18rpx;background:#f0f0e9;white-space:nowrap;cursor:pointer}.select-subcategory-tab.active{background:#e9ede1;color:#58684b;border-color:#d5dacb}.select-picker-list{height:42vh;margin-top:12rpx;border-top:1rpx solid #e7e6de}
