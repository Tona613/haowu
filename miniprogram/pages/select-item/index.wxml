<view class="page select-item-page"><view class="title serif">留下这一刻</view><view class="select-search"><text class="select-search-icon">⌕</text><input value="{{query}}" placeholder="搜索物品名称" bindinput="search" confirm-type="search"/></view><button class="select-chooser" bindtap="openPicker"><text class="select-chooser-plus">＋</text><text>从物品中选择</text><text class="select-chooser-chevron">›</text></button><view wx:if="{{query}}" class="select-results"><view class="section-title">搜索结果</view><view wx:for="{{searchResults}}" wx:key="id" class="select-item-row" bindtap="choose" data-id="{{item.id}}"><view class="select-thumb"><art src="{{item.photo}}" kind="{{item.art}}"/></view><view class="select-item-copy"><view class="select-item-name">{{item.name}}</view><view class="small muted">{{item.dayText}}</view></view><text class="select-chevron">›</text></view><view wx:if="{{!searchResults.length}}" class="empty small">没有找到正在陪伴的物品</view></view><view wx:else><view class="row select-section-head"><view class="section-title">最近的故事</view><text class="small muted">{{recent.length}} 条</text></view><view wx:if="{{!recent.length}}" class="empty small">还没有留下故事</view><view wx:for="{{recent}}" wx:key="id" class="select-story-row" bindtap="choose" data-id="{{item.itemId}}" role="button" aria-label="记录 {{item.itemName}} 的故事"><view class="select-story-thumb"><art src="{{item.photos[0] || item.itemPhoto}}" kind="{{item.art || item.itemArt}}"/></view><view class="select-story-body"><view class="select-story-item">{{item.itemName}} · 陪伴第 {{item.day}} 天 ›</view><view class="select-story-excerpt">{{item.text || '留下一张照片'}}</view><view class="select-story-date">{{item.date}}</view></view></view></view></view><view wx:if="{{picker}}" class="select-picker-wrap"><view class="select-picker-mask" bindtap="closePicker"/><view class="select-picker"><view class="select-picker-header"><view class="select-picker-title">选择物品</view><button bindtap="closePicker">完成</button></view><view class="select-picker-note">选择一件正在陪伴你的好物</view><scroll-view class="select-category-scroll" scroll-x="true"><view class="select-category-track"><view wx:for="{{pickerCategories}}" wx:key="id" class="select-category-tab {{categoryId===item.id?'active':''}}" bindtap="selectParent" data-id="{{item.id}}">{{item.name}}</view></view></scroll-view><scroll-view wx:if="{{categoryId}}" class="select-subcategory-scroll" scroll-x="true"><view class="select-subcategory-track"><view wx:for="{{pickerChildren}}" wx:key="id" class="select-subcategory-tab {{subId===item.id?'active':''}}" bindtap="selectChild" data-id="{{item.id}}">{{item.name}}</view></view></scroll-view><scroll-view scroll-y="true" class="select-picker-list"><view wx:for="{{pickerItems}}" wx:key="id" class="select-item-row" bindtap="choose" data-id="{{item.id}}"><view class="select-thumb"><art src="{{item.photo}}" kind="{{item.art}}"/></view><view class="select-item-copy"><view class="select-item-name">{{item.name}}</view><view class="small muted">{{item.dayText}}</view></view><text class="select-chevron">›</text></view><view wx:if="{{!pickerItems.length}}" class="empty small">没有符合分类的正在陪伴物品</view></scroll-view></view></view>
