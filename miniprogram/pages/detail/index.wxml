<view wx:if="{{item}}" class="page"><view class="detail-hero {{item.photo?'detail-hero-natural':''}}" bindtap="previewPhoto"><art src="{{item.photo}}" kind="{{item.art}}" fit="natural"/></view><view class="row section"><view class="title detail-title">{{item.name}}</view><text class="badge">{{item.stateText}}</text></view><view class="row"><text class="small muted">{{item.category}} · {{item.sub}}</text><button class="link" bindtap="manage">管理 ···</button></view><view class="small muted">{{item.start}} {{item.departure?'— '+item.departure.date:(item.source==='自己购买'?'购入':'来到身边')}}</view><view class="stats"><view class="stat"><view class="stat-label">{{item.departure?'曾陪伴':'陪伴天数'}}</view><view class="stat-value">{{item.days}} <text class="small">天</text></view></view><view class="stat"><view class="stat-label">购入价格</view><view class="stat-value">{{item.priceText}}</view></view><view class="stat"><view class="stat-label">日均成本</view><view class="stat-value">{{item.daily}}</view></view></view><view wx:if="{{item.reason}}" class="section"><view class="section-title">来到身边的理由</view><view class="body-copy small" style="margin-top:14rpx">{{item.reason}}</view></view><view class="menu-row" bindtap="about"><text class="serif">关于它</text><text class="muted">›</text></view><view class="tabs"><view class="tab {{tab==='stories'?'active':''}}" bindtap="tab" data-tab="stories">故事 {{stories.length}}</view><view class="tab {{tab==='repairs'?'active':''}}" bindtap="tab" data-tab="repairs">维修 {{repairs.length}}</view><view class="tab {{tab==='review'?'active':''}}" bindtap="tab" data-tab="review">评价</view></view><view wx:if="{{tab==='stories'}}"><view wx:if="{{stories.length}}" class="timeline"><view class="row"><text class="small muted">{{stories[0].date}} · 陪伴第 {{stories[0].day}} 天</text><button class="link" bindtap="allStories">全部 ›</button></view><view class="story-text">{{stories[0].text}}</view><view wx:if="{{stories[0].photos.length || stories[0].art}}" class="story-photo"><art src="{{stories[0].photos[0]}}" kind="{{stories[0].art}}"/></view></view><view wx:else class="empty">还没有留下故事<view class="hint">记录它陪伴你的那些时刻</view></view></view><view wx:if="{{tab==='repairs'}}"><view class="menu-row" bindtap="allRepairs"><text>共计 {{repairs.length}}次 · 累计 ¥{{repairTotal}}</text><text>全部 ›</text></view><view wx:for="{{repairs}}" wx:key="id" wx:if="{{index===0}}" class="timeline" bindtap="editRecord" data-kind="repairs" data-id="{{item.id}}"><view class="small muted">{{item.date}}</view><view>{{item.problem}}</view><view class="small muted">{{item.treatment}}</view><view class="small green">{{item.costText}}</view></view><view wx:if="{{!repairs.length}}" class="empty">还没有维修记录<view class="hint">如果它以后坏了、修过，可以留在这里。</view></view></view><view wx:if="{{tab==='review'}}" class="section"><view wx:if="{{review}}"><view>优点 ×{{review.pros.length}}</view><view class="small green">{{prosText || '暂无记录'}}</view><view style="margin-top:20rpx">缺点 ×{{review.cons.length}}</view><view class="small muted">{{consText || '暂无记录'}}</view><view class="note" style="margin-top:24rpx">重新选择：{{review.again==='会'?'还会买':review.again==='不会'?'不会再买':'不确定'}}</view></view><view wx:else class="empty">相处一段时间以后，<view class="line-break"/>你觉得它怎么样？</view></view><view class="actions"><button class="secondary" bindtap="story">写故事</button><button class="secondary" bindtap="repair">记维修</button><button class="secondary" bindtap="review">{{review?'编辑评价':'写评价'}}</button></view><view wx:if="{{!item.departure}}" class="menu-row section" bindtap="leave"><view><view class="serif">记录离开</view><view class="hint">离开后，故事依然保留。</view></view><text>›</text></view><view wx:else class="section note">{{item.departure.date}} · {{item.stateText}}<view wx:if="{{item.departure.price!==null}}">卖出价格 ¥{{item.departure.price}}</view><view class="body-copy">{{item.departure.note}}</view><view class="hint">这段陪伴已结束，故事仍然保留。</view></view></view><view wx:else class="empty">物品不存在或无法读取，请返回重试。</view>
