<view class="page home-page"><view class="eyebrow serif">好物相伴，日久有情。</view><view class="row home-all-entry" bindtap="all" role="button" aria-label="查看全部物品"><view class="title">正在陪伴你<text class="count">{{count}} <text class="small">件</text></text></view><text class="small">全部 ›</text></view><view wx:for="{{limits}}" wx:key="id" class="note" bindtap="limit" data-id="{{item.id}}" data-category="{{item.categoryId}}">{{item.text}} ›</view><view class="home-actions"><button bindtap="add">＋ 添加物品</button><button bindtap="story">✎ 记录故事</button></view><view class="row home-showcase-heading"><view class="section-title">我的好物展台</view><button class="home-text-button" bindtap="manage">{{items.length}}/6 · 管理 ›</button></view><view class="showcase" wx:if="{{loaded}}">
  <view wx:if="{{!items.length}}" class="showcase-empty" bindtap="pick" role="button" aria-label="选择好物放入展台">
    <view class="showcase-display"><view class="showcase-frame showcase-frame-empty"><view class="showcase-invitation-art"><view class="invitation-card invitation-card-back"><view class="invitation-landscape"><view class="invitation-sun"/><view class="invitation-hill invitation-hill-one"/><view class="invitation-hill invitation-hill-two"/></view></view><view class="invitation-card invitation-card-front"><view class="invitation-stem"/><view class="invitation-leaf invitation-leaf-one"/><view class="invitation-leaf invitation-leaf-two"/><view class="invitation-leaf invitation-leaf-three"/><view class="invitation-leaf invitation-leaf-four"/></view><text class="invitation-heart">♡</text><text class="invitation-spark">✧</text><view class="invitation-plus"><text>＋</text></view></view><view class="showcase-invitation-copy"><view>放入让你超级喜爱的</view><view>物品吧~</view></view></view><view class="showcase-base"/></view>
    
  </view>
  <block wx:else>
    <swiper class="showcase-carousel" next-margin="180rpx" current="{{activeStage}}" duration="300" bindchange="stageChange">
      <swiper-item wx:for="{{items}}" wx:key="id"><view class="showcase-slide" bindtap="open" data-id="{{item.id}}" role="button" aria-label="{{item.name}}">
        <view class="showcase-display"><view class="showcase-frame"><view class="showcase-photo"><art src="{{item.photo}}" kind="{{item.art}}" fit="contain"/></view><view class="showcase-label"><view class="showcase-name">{{item.name}}</view></view></view><view class="showcase-base"><text class="showcase-base-days">{{item.dayText}}</text></view></view>
        
      </view></swiper-item>
      <swiper-item wx:if="{{items.length<6}}"><view class="showcase-slide" bindtap="pick" role="button" aria-label="选择好物放入展台">
        <view class="showcase-display"><view class="showcase-frame showcase-frame-empty"><view class="showcase-invitation-art"><view class="invitation-card invitation-card-back"><view class="invitation-landscape"><view class="invitation-sun"/><view class="invitation-hill invitation-hill-one"/><view class="invitation-hill invitation-hill-two"/></view></view><view class="invitation-card invitation-card-front"><view class="invitation-stem"/><view class="invitation-leaf invitation-leaf-one"/><view class="invitation-leaf invitation-leaf-two"/><view class="invitation-leaf invitation-leaf-three"/><view class="invitation-leaf invitation-leaf-four"/></view><text class="invitation-heart">♡</text><text class="invitation-spark">✧</text><view class="invitation-plus"><text>＋</text></view></view><view class="showcase-invitation-copy"><view>放入让你超级喜爱的</view><view>物品吧~</view></view></view><view class="showcase-base"/></view>
        
      </view></swiper-item>
    </swiper>
    <view class="showcase-dots"><view wx:for="{{stageDots}}" wx:key="*this" class="showcase-dot {{activeStage===item?'showcase-dot-active':''}}"/></view>
  </block>
</view><view class="section"><view class="row"><view class="section-title">最近的故事</view><button class="home-text-button" bindtap="allStories">全部 ›</button></view><view wx:if="{{!stories.length}}" class="empty small">还没有留下故事<view class="line-break"/>下一次心动的瞬间，记在这里。</view><view wx:for="{{stories}}" wx:key="id" class="story-row"><view wx:if="{{item.photos.length || item.art}}" class="story-thumb"><art src="{{item.photos[0]}}" kind="{{item.art}}"/></view><view class="story-body"><view class="story-head" bindtap="open" data-id="{{item.itemId}}">{{item.itemName}} · 陪伴第 {{item.day}} 天 ›</view><view class="story-text">{{item.text}}</view><view class="muted tiny">{{item.date}}</view></view></view></view><view class="safe-bottom"/><button class="share-float" bindtap="share" aria-label="分享好物"><view class="share-float-icon"><view class="share-float-arrow"><view class="share-float-head-left"/><view class="share-float-head-right"/><view class="share-float-shaft"/></view><view class="share-float-base"/></view><text class="share-float-label">分享好物</text></button></view>
<view wx:if="{{panel}}" class="home-panel-backdrop" bindtap="closePanel"/>
<view wx:if="{{panel}}" class="home-panel" role="dialog" aria-label="展台与故事">
 <view class="row home-panel-header"><view class="section-title">{{panel==='manage'?'整理展台':panel==='stories'?'全部故事':panel==='target'?'选择要替换的好物':replacingId?'选择替换的好物':'放入好物'}}</view><button class="home-text-button" bindtap="closePanel">完成</button></view>
 <view wx:if="{{panel!=='stories'}}" class="small muted home-panel-note">{{panel==='manage'?'调整展示顺序，移出不会删除物品档案。':panel==='target'?'展台已满，替换只改变首页展示。':'从正在陪伴你的物品中选择。'}}</view>
 <scroll-view wx:if="{{panel==='pick'}}" class="home-pick-category-scroll" scroll-x="true"><view class="home-pick-category-track"><view wx:for="{{pickerCategories}}" wx:key="id" class="home-pick-category-tab {{pickCategoryId===item.id?'active':''}}" bindtap="selectPickParent" data-id="{{item.id}}">{{item.name}}</view></view></scroll-view>
 <scroll-view wx:if="{{panel==='pick' && pickCategoryId}}" class="home-pick-subcategory-scroll" scroll-x="true"><view class="home-pick-category-track"><view wx:for="{{pickerChildren}}" wx:key="id" class="home-pick-subcategory-tab {{pickSubId===item.id?'active':''}}" bindtap="selectPickChild" data-id="{{item.id}}">{{item.name}}</view></view></scroll-view>
 <scroll-view scroll-y="true" class="home-panel-scroll">
  <block wx:if="{{panel==='manage'}}">
   <view wx:if="{{!items.length}}" class="empty small">展台还空着，选一件喜欢的好物吧。</view>
   <view wx:for="{{items}}" wx:key="id" class="home-manage-row"><view class="home-pick-name">{{index+1}} · {{item.name}}</view><view class="home-manage-actions"><button bindtap="move" data-id="{{item.id}}" data-step="-1" disabled="{{index===0}}" aria-label="向前移动">前移</button><button bindtap="move" data-id="{{item.id}}" data-step="1" disabled="{{index===items.length-1}}" aria-label="向后移动">后移</button><button bindtap="replace" data-id="{{item.id}}">替换</button><button bindtap="remove" data-id="{{item.id}}">移出</button></view></view>
   <button wx:if="{{items.length<6}}" class="secondary full" bindtap="pick">＋ 放入好物</button>
  </block>
  <block wx:elif="{{panel==='pick'}}">
   <view wx:if="{{!candidates.length}}" class="empty small">{{count?'正在陪伴你的物品都已在展台上。':'还没有物品，先添加一件好物吧。'}}</view>
   <button wx:if="{{!count}}" class="secondary full" bindtap="add">＋ 添加物品</button>
   <view wx:for="{{candidates}}" wx:key="id" class="home-pick-row" role="button" bindtap="choose" data-id="{{item.id}}"><view class="home-pick-photo"><art src="{{item.photo}}" kind="{{item.art}}" fit="contain"/></view><view class="home-pick-copy"><view class="home-pick-name">{{item.name}}</view><view class="small muted">{{item.dayText}}</view></view><text class="green">{{replacingId?'替换':'放入'}} ＋</text></view>
  </block>
  <block wx:elif="{{panel==='target'}}"><view wx:for="{{items}}" wx:key="id" class="home-pick-row" role="button" bindtap="chooseTarget" data-id="{{item.id}}"><view class="home-pick-name">{{item.name}}</view><text class="green">替换 ›</text></view></block>
  <block wx:else><view wx:if="{{!allStories.length}}" class="empty small">还没有留下故事</view><view wx:for="{{allStories}}" wx:key="id" class="home-story-entry" bindtap="open" data-id="{{item.itemId}}" role="button"><view class="small green">{{item.itemName}} · {{item.date}} ›</view><view class="story-text">{{item.text}}</view><view wx:if="{{item.photos.length}}" class="home-story-photo"><art src="{{item.photos[0]}}"/></view></view></block>
 </scroll-view>
</view>
